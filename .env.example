# GastOS — Variables de entorno requeridas
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas el archivo .env.local al repositorio.

# ── Supabase ──────────────────────────────────────────────────────────────────
# URL del proyecto Supabase (visible en Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave anon/public de Supabase (segura para exponer en cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Clave service_role de Supabase — SOLO usar en rutas de servidor (API routes).
# Tiene acceso total sin RLS. NUNCA la expongas en código cliente.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── Resend (email) ────────────────────────────────────────────────────────────
# API key de Resend para enviar emails de feedback
RESEND_API_KEY=re_<key>

# Email destino donde se recibirán los tickets de feedback de usuarios
FEEDBACK_TO_EMAIL=soporte@tudominio.com
